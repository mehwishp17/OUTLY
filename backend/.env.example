# Copy to .env - never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://outly:outly_dev_password@127.0.0.1:5433/outly
REDIS_URL=redis://127.0.0.1:6379/0
# Comma-separated browser origins allowed to call the API directly
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Email (the console backend prints mail to the terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OUTLY <no-reply@outly.local>
# Real delivery through Brevo SMTP: uncomment these, set EMAIL_BACKEND to the SMTP backend (or remove that line
# above), and put the real values only in your private backend/.env - never in this file or in chat.
#   Host/port/encryption below are Brevo's: smtp-relay.brevo.com, port 587, STARTTLS (TLS on, SSL off).
#   EMAIL_HOST_USER is the SMTP login shown in your Brevo account; EMAIL_HOST_PASSWORD is the generated SMTP
#   key (not your Brevo account password). DEFAULT_FROM_EMAIL must be a sender you have verified in Brevo.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=<your-brevo-smtp-login>
# EMAIL_HOST_PASSWORD=<your-brevo-smtp-key>
# DEFAULT_FROM_EMAIL=OUTLY <your-verified-sender@example.com>
# EMAIL_TIMEOUT=10
FRONTEND_URL=http://localhost:3000
# Media storage (local filesystem by default)
MEDIA_ROOT=media
MEDIA_URL=/media/
MEDIA_MAX_UPLOAD_MB=5
# Persistent media (optional). Cloudinary is used only if ALL THREE are set; leave empty for
# local-disk storage. Never commit real values.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Public base URL of this API, used only for media URLs in WebSocket payloads when media is
# stored locally (e.g. https://your-api.example.com). Empty = no change in behaviour.
PUBLIC_API_URL=
# Product rules
EVENTS_REQUIRE_MODERATION=false
