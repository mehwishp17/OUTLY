# Copy to .env - never commit real values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://outly:outly_dev_password@127.0.0.1:5433/outly
REDIS_URL=redis://127.0.0.1:6379/0
# Comma-separated browser origins allowed to call the API directly
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# JWT lifetimes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# Email (the console backend prints mail to the terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=OUTLY <no-reply@outly.local>
FRONTEND_URL=http://localhost:3000
# Media storage (local filesystem by default)
MEDIA_ROOT=media
MEDIA_URL=/media/
MEDIA_MAX_UPLOAD_MB=5
# Product rules
EVENTS_REQUIRE_MODERATION=false
